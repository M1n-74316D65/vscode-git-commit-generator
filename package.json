{
  "name": "vscode-llm-api-git-commit-generator",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.3.0",
  "publisher": "m1n",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/M1n-74316D65/vscode-git-commit-generator"
  },
  "homepage": "https://github.com/M1n-74316D65/vscode-git-commit-generator",
  "bugs": {
    "url": "https://github.com/M1n-74316D65/vscode-git-commit-generator/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "message",
    "conventional-commits",
    "gitmoji",
    "ai",
    "copilot"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-commit-generator.generate",
        "title": "%commands.generate%",
        "category": "%commands.category%",
        "icon": "$(sparkle)",
        "enablement": "gitOpenRepositoryCount > 0"
      },
      {
        "command": "git-commit-generator.generateStaged",
        "title": "%commands.generateStaged%",
        "category": "%commands.category%",
        "enablement": "gitOpenRepositoryCount > 0"
      },
      {
        "command": "git-commit-generator.generateAll",
        "title": "%commands.generateAll%",
        "category": "%commands.category%",
        "enablement": "gitOpenRepositoryCount > 0"
      },
      {
        "command": "git-commit-generator.selectModel",
        "title": "%commands.selectModel%",
        "category": "%commands.category%",
        "icon": "$(cloud)",
        "enablement": "gitOpenRepositoryCount > 0"
      },
      {
        "command": "git-commit-generator.openSettings",
        "title": "%commands.openSettings%",
        "category": "%commands.category%"
      },
      {
        "command": "git-commit-generator.refreshModels",
        "title": "%commands.refreshModels%",
        "category": "%commands.category%"
      },
      {
        "command": "git-commit-generator.selectStyle",
        "title": "%commands.selectStyle%",
        "category": "%commands.category%",
        "icon": "$(symbol-color)",
        "enablement": "gitOpenRepositoryCount > 0"
      },
      {
        "command": "git-commit-generator.toggleGitmojis",
        "title": "%commands.toggleGitmojis%",
        "category": "%commands.category%",
        "icon": "$(symbol-enum)",
        "enablement": "gitOpenRepositoryCount > 0"
      },
      {
        "command": "git-commit-generator.showLogs",
        "title": "%commands.showLogs%",
        "category": "%commands.category%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "git-commit-generator.generate",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "git-commit-generator.generateStaged",
          "group": "1_generate@1",
          "when": "scmProvider == git"
        },
        {
          "command": "git-commit-generator.generateAll",
          "group": "1_generate@2",
          "when": "scmProvider == git"
        },
        {
          "command": "git-commit-generator.selectModel",
          "group": "2_configuration@1",
          "when": "scmProvider == git"
        },
        {
          "command": "git-commit-generator.selectStyle",
          "group": "2_configuration@2",
          "when": "scmProvider == git"
        },
        {
          "command": "git-commit-generator.toggleGitmojis",
          "group": "2_configuration@3",
          "when": "scmProvider == git",
          "toggled": "config.gitCommitGenerator.useGitmojis"
        }
      ],
      "commandPalette": [
        {
          "command": "git-commit-generator.generate",
          "when": "gitOpenRepositoryCount > 0"
        },
        {
          "command": "git-commit-generator.generateStaged",
          "when": "gitOpenRepositoryCount > 0"
        },
        {
          "command": "git-commit-generator.generateAll",
          "when": "gitOpenRepositoryCount > 0"
        },
        {
          "command": "git-commit-generator.selectStyle",
          "when": "gitOpenRepositoryCount > 0"
        },
        {
          "command": "git-commit-generator.toggleGitmojis",
          "when": "gitOpenRepositoryCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "gitCommitGenerator.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "es",
            "fr",
            "de",
            "it",
            "pt",
            "ja"
          ],
          "enumDescriptions": [
            "%configuration.language.auto%",
            "%configuration.language.en%",
            "%configuration.language.es%",
            "%configuration.language.fr%",
            "%configuration.language.de%",
            "%configuration.language.it%",
            "%configuration.language.pt%",
            "%configuration.language.ja%"
          ],
          "description": "%configuration.language.description%"
        },
        "gitCommitGenerator.style": {
          "type": "string",
          "default": "conventional",
          "enum": [
            "conventional",
            "angular",
            "atom",
            "eslint",
            "jquery",
            "ember",
            "linux",
            "symfony",
            "rails",
            "graphql",
            "docker",
            "karma",
            "semantic",
            "plain",
            "bitbucket"
          ],
          "enumDescriptions": [
            "%configuration.style.conventional%",
            "%configuration.style.angular%",
            "%configuration.style.atom%",
            "%configuration.style.eslint%",
            "%configuration.style.jquery%",
            "%configuration.style.ember%",
            "%configuration.style.linux%",
            "%configuration.style.symfony%",
            "%configuration.style.rails%",
            "%configuration.style.graphql%",
            "%configuration.style.docker%",
            "%configuration.style.karma%",
            "%configuration.style.semantic%",
            "%configuration.style.plain%",
            "%configuration.style.bitbucket%"
          ],
          "description": "%configuration.style.description%"
        },
        "gitCommitGenerator.useGitmojis": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.useGitmojis%"
        },
        "gitCommitGenerator.includeBody": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.includeBody%"
        },
        "gitCommitGenerator.bodyThreshold": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "%configuration.bodyThreshold%"
        },
        "gitCommitGenerator.recentCommitsCount": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 50,
          "description": "%configuration.recentCommitsCount%"
        },
        "gitCommitGenerator.excludeFiles": {
          "type": "array",
          "default": [
            "**/package-lock.json",
            "**/.env*"
          ],
          "items": {
            "type": "string"
          },
          "description": "%configuration.excludeFiles%"
        },
        "gitCommitGenerator.modelFamily": {
          "type": "string",
          "default": "gpt-4o",
          "description": "%configuration.modelFamily%"
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf out",
    "vscode:prepublish": "bun run compile",
    "compile": "bun run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "bun run compile",
    "test": "vscode-test",
    "package:vsix": "bun scripts/package-vsix.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.90.0",
    "@types/node": "20.x",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.3.0"
  }
}
